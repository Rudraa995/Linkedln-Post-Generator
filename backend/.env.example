# OpenRouter AI Configuration (Required for text generation)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Image Generation API Configuration (Optional)
IMAGE_GENERATION_API_KEY=your_image_api_key_here
IMAGE_GENERATION_PROVIDER=openrouter
IMAGE_GENERATION_MODEL=black-forest-labs/flux-1-schnell
IMAGE_GENERATION_BASE_URL=https://openrouter.ai/api/v1

# App Configuration
FRONTEND_URL=http://localhost:3000
BACKEND_PORT=8000
